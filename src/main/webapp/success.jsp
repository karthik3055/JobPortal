<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Success - JobPortal</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7ff;
        }

        .box {
            width: 90%;
            max-width: 500px;

            margin: 100px auto;

            padding: 40px;

            background: white;

            border-radius: 12px;

            box-shadow: 0 5px 20px #ddd;

            text-align: center;
        }

        h1 {
            color: #16a34a;
        }

        p {
            color: #64748b;
        }

        a {
            display: inline-block;

            margin: 8px;

            padding: 12px 22px;

            background: #4f46e5;

            color: white;

            text-decoration: none;

            border-radius: 7px;

            font-weight: bold;
        }

        a:hover {
            background: #3730a3;
        }

    </style>

</head>

<body>

<div class="box">

    <h1>Application Submitted!</h1>

    <p>
        Your application has been successfully saved.
    </p>

    <a href="findJobs">
        View Jobs
    </a>

    <a href="index.html">
        Home
    </a>

</div>

</body>
</html>